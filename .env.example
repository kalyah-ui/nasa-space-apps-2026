# Public browser configuration. A Mapbox public token is expected here.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiYXJtZWVuYXNhamoiLCJhIjoiY213Z3d6YTF3MGdzMjMwcTRiM3NoZ2hpNiJ9.iCZtajque6BxyTIFijxu4Q
NEXT_PUBLIC_DATA_PROVIDER=api

# Server-only Discovery research keys: Tavily searches; normal Gemini summarizes.
# TAVILY_API_KEY=
# GEMINI_API_KEY=
# GEMINI_SEARCH_MODEL=gemini-3.8-flash
# GEMINI_SUMMARY_FALLBACK_MODEL=gemini-3.1-flash-lite

# Server-only Google Cloud configuration. Never prefix credentials with NEXT_PUBLIC_.
GOOGLE_CLOUD_PROJECT=nasa-spaceapps-2026
GCS_BUCKET_NAME=nasa_spaceapps_2026_loam

# Use an attached service identity / Application Default Credentials when possible.
# Vercel keyless authentication: set all four values in Production.
# Use Allowed audiences = https://vercel.com/TEAM_SLUG in the Google provider.
# GCP_PROJECT_NUMBER=123456789012
# GCP_SERVICE_ACCOUNT_EMAIL=loam-vercel@nasa-spaceapps-2026.iam.gserviceaccount.com
# GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# See docs/vercel-google-cloud.md for the identity and bucket permissions.

# Legacy alternative for other hosts; OIDC takes precedence when configured:
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GCP_SERVICE_ACCOUNT_JSON_BASE64=

# Optional server-side object and prefix overrides.
FIELDS_GCS_OBJECT=processed/fields/ontario-fields.geojson
SRTM_GCS_PREFIX=raw/srtm-global-1-arc-second-v003:ontario/
LANDSAT_GCS_PREFIX=raw/landsat-surface-reflectance-collection-2-level-2-ontario/landsat-sample/LC08_L2SP_016028_20260923_02_T1/
CANSIS_PROCESSED_OBJECT=processed/cansis-slc-v3-2/ontario-regions.geojson
SOIL_UPLOAD_PREFIX=uploads/soil-csv/
